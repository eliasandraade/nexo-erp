# Caddy static server for the Orken SPA (production).
# Guarantees compression + correct cache headers regardless of platform
# autodetection. Railway terminates TLS at its edge and injects $PORT, so Caddy
# serves plain HTTP on that port.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv

	# Compress responses (zstd preferred, gzip fallback). Brotli needs a Caddy
	# plugin; zstd+gzip covers all browsers and is built in.
	encode zstd gzip

	# Security headers on every response (the app on erp.orken.com.br and the Build portal on www.orken.com.br). Framing
	# is refused; geolocation stays allowed for the app itself (project page), camera, microphone and USB are not used.
	#
	# Content-Security-Policy: the full policy is report-only for now (docs/security/csp.md: what each source is for, how to read
	# the reports and how to move to enforcing). Only frame-ancestors is enforced. A PDF in an <object> and the WebAssembly of the
	# IFC converter do fit in a full policy: they are the 'object-src blob:', the 'frame-src blob:' and the 'wasm-unsafe-eval' below.
	# Hosts that differ per environment, read when the server starts. The defaults are production's, so production needs none:
	#   CSP_API_ORIGIN       the API, for requests and for the reports
	#   CSP_HUB_ORIGIN       the same API by WebSocket, for the kitchen hub
	#   CSP_STORAGE_ORIGINS  the object store (public files and signed URLs), one or more origins separated by a space
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Content-Security-Policy-Report-Only "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$CSP_STORAGE_ORIGINS:https://*.r2.cloudflarestorage.com https://*.r2.dev} https://images.openfoodfacts.org; font-src 'none'; connect-src 'self' blob: {$CSP_API_ORIGIN:https://api.erp.orken.com.br} {$CSP_HUB_ORIGIN:wss://api.erp.orken.com.br} https://viacep.com.br {$CSP_STORAGE_ORIGINS:https://*.r2.cloudflarestorage.com https://*.r2.dev}; worker-src 'self'; frame-src blob:; object-src blob:; media-src {$CSP_STORAGE_ORIGINS:https://*.r2.cloudflarestorage.com https://*.r2.dev}; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; report-uri {$CSP_API_ORIGIN:https://api.erp.orken.com.br}/api/csp-reports"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), usb=(), geolocation=(self)"
	}

	# Hashed asset filenames (e.g. index-BJE3iSeJ.js) change on every build, so
	# they can be cached forever. This is the big first-vs-repeat-load win.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Never take the HTML entry point from a cache without asking, so a new deploy (or a rollback of the bundle) reaches
	# the next visit instead of a stale shell that references other chunks. That is every path that is not a hashed asset:
	# "/" and "/index.html", and every client route (/login, /dashboard, …) that try_files below answers with the same
	# index.html. Matchers see the path the browser asked for, before try_files rewrites it, so a list of the two names
	# alone left the client routes with no Cache-Control, and a browser kept the shell by heuristic freshness (a tenth of
	# the time since Last-Modified, hours after a few days) without asking the server. "no-cache" still lets the
	# browser revalidate with the ETag and get a 304 when nothing changed.
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# The Orken institutional entry is the portal on app.orken.com.br (docs/engineering/public-hosts.md). Only a visit
	# (GET or HEAD) to the root of www goes there, with its query string; every other path on www (Build portals, menus,
	# booking, tracking, account links) is still served below, and erp.orken.com.br keeps its own root. 307: browsers
	# do not cache it, so the root can come back to www later.
	@institutional {
		host www.orken.com.br
		method GET HEAD
		path /
	}
	redir @institutional https://app.orken.com.br{uri} 307

	# The root of erp.orken.com.br is the entry of the ERP, not another institutional page: a visit goes to the sign-in
	# page with its query string. This server cannot see the session: it stays in the browser, in storage or in a cookie of the API's
	# own host depending on the build, and only ever goes to the API. The sign-in page sends a signed-in user on to their own
	# destination (AuthLayout). Any other host keeps the SPA at the root, so Railway's healthcheck still gets a 200.
	@erpEntry {
		host erp.orken.com.br
		method GET HEAD
		path /
	}
	redir @erpEntry /login{?query} 307

	# SPA fallback: client-side routes (/dashboard, /vendas, …) resolve to the
	# app shell; real files (assets, favicon) are served directly.
	try_files {path} /index.html
	file_server
}
